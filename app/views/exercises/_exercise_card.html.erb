<div class="bg-white rounded-xl shadow-sm">
  <div class="flex justify-between py-3 px-6 items-center">

    <div class="flex flex-col gap-2">
      <h3 class="text-md font-semibold text-gray-900"><%= exercise.name %></h3>
      <p class="text-green-800 text-sm font-semibold rounded-md bg-green-100 px-2 py-0.5 text-center w-fit"><%= exercise.category %></p>
    </div>

    <%= button_tag type: "button",
      class: "icon cursor-pointer rounded-full h-fit w-fit" do %>
      <%= inline_svg_tag "icons/plus.svg", class: "responsive-icon text-indigo-600 text-center" %>
    <% end %>

  </div>
</div>
