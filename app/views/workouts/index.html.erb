<div class="flex flex-col gap-4">
  <div class="flex justify-between mb-4">
    <h1 class="font-bold text-4xl">My Workouts</h1>
    <%= link_to 'New Workout Template',
      new_workout_path(template: true),
      class: "bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 transition duration-150"
    %>
  </div>

  <div class="flex flex-col gap-4" data-controller="workout-tab">
    <div class="flex justify-between bg-white px-4 py-2 rounded-xl shadow-sm">
      <div class="flex gap-2">
        <%= link_to workouts_completed_path,
          data: { turbo_frame: "workouts-frame", action: "workout-tab#update", tab: "completed", workout_tab_target: "tab" } do %>
          <div class="flex items-center tab">
            <%= inline_svg_tag "icons/layout-grid.svg", class: "responsive-icon h-5 w-5" %>
            Completed
          </div>
        <% end %>

        <%= link_to workouts_templates_path,
          data: { turbo_frame: "workouts-frame", action: "workout-tab#update", tab: "templates", workout_tab_target: "tab" } do %>
          <div class="flex items-center tab">
            <%= inline_svg_tag "icons/notebook-text.svg", class: "responsive-icon h-5 w-5" %>
            Templates
          </div>
        <% end %>

        <%= link_to workouts_templates_path,
          data: { turbo_frame: "workouts-frame", action: "workout-tab#update", tab: "stats", workout_tab_target: "tab" } do %>
          <div class="flex items-center tab">
            <%= inline_svg_tag "icons/chart-no-axes-column-increasing.svg", class: "responsive-icon h-5 w-5" %>
            Stats
          </div>
        <% end %>
      </div>

      <div class="flex gap-4">
        <div class="flex items-center border border-gray-500 text-gray-700 rounded-lg font-medium px-4 py-2 gap-2">
          <%= inline_svg_tag "icons/filter.svg", class: "responsive-icon h-5 w-5" %>
          <%= link_to "Filter", url_for(request.path_parameters.merge(request.query_parameters).merge(tab: "completed")) %>
        </div>
      </div>
    </div>

    <%= render "workouts/completed", workouts: @workouts %>
  </div>
</div>
