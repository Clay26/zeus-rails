<%= turbo_frame_tag "exercise-drawer" do %>
<div class="flex flex-col gap-4 h-full bg-gray-150 rounded-lg shadow-lg">

  <div class="sticky top-0 rounded-lg shadow-sm" data-controller="filter" data-default="all" data-param="category">

    <div class="bg-white flex justify-between rounded-xl py-6 px-4 border-b-1 border-gray-200 rounded-b-none">
      <div class="flex items-center gap-4">
        <%= button_tag type: "button",
          data: {
            action: "click->drawer#close"
          },
          class: "cursor-pointer" do %>
          <%= inline_svg_tag "icons/arrow-left.svg", class: "text-gray-400 w-6 h-6 hover:text-gray-600" %>
        <% end %>

        <h1 class="text-xl font-semibold">Add Exercise</h1>
      </div>

      <%= link_to 'New Exercise', new_exercise_path, class: "button main-button" %>
    </div>

    <div class="px-6 py-4 border-b border-gray-200 bg-white">
      <%= form_with url: exercises_path,
        method: :get,
        data: { turbo_frame: "exercise-list-frame" },
        local: true do |f| %>
        <div class="flex items-center gap-2 border border-gray-200 rounded-xl shadow-sm focus-within:ring-1 focus-within:ring-indigo-400 focus-within:border-indigo-400 px-3">
          <%= inline_svg_tag "icons/search.svg", class: "text-gray-400 flex-grow-0", size: "20" %>
          <%= f.text_field :search, vale: params[:search], placeholder: "Search exercises...", class: "w-full pr-4 py-3 outline-none border-none bg-transparent" %>
        </div>
        <%= hidden_field_tag :category, params[:category], data: { filter_target: "formField" } %>
      <% end %>
    </div>

    <div class="px-6 py-4 border-b border-gray-100 bg-white overflow-x-auto flex gap-2 rounded-b-xl">
      <%= link_to "All", exercises_path,
        data: {
          turbo_frame: "exercise-list-frame",
          turbo_action: "replace", turbo_method: "get",
          filter_target: "filter",
          name: "all",
          action: "click->filter#update"
        },
        class: "tab rounded-xl text-sm font-medium whitespace-nowrap"
      %>

    <% categories.each do |category| %>
      <%= link_to category, exercises_path(category: category.downcase),
        data: {
          turbo_frame: "exercise-list-frame",
          turbo_action: "replace", turbo_method: "get",
          filter_target: "filter",
          name: category.downcase,
          action: "click->filter#update"
        },
        class: "tab rounded-xl text-sm font-medium whitespace-nowrap"
      %>
    <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "exercise-list-frame", class: "flex flex-col gap-4 overflow-y-auto" do %>
    <% exercises.each do |exercise| %>
      <%= render partial: "exercise_card", locals: { exercise: exercise } %>
    <% end %>
  <% end %>
</div>
<% end %>
